[9.316, "o", "\u001b[33m(neighbor)\u001b[0m started the two abusers (a fork bomb and a CPU spinner)\r\n"]
[9.426, "o", "\u001b[33m(neighbor)\u001b[0m started the well-behaved neighbour\r\n"]
[9.536, "o", "\u001b[33m(neighbor)\u001b[0m neighbour computed the right answer\r\n"]
[9.646, "o", "\u001b[1m\u001b[33m(neighbor)\u001b[0m\u001b[1m neighbour finished within the deadline\u001b[0m\r\n"]
