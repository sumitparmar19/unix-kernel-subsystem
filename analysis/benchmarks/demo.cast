{"version": 2, "width": 92, "height": 32, "title": "unix-kernel-subsystem demo", "env": {"TERM": "xterm-256color"}}
[0.2, "o", "\u001b[1munix-kernel-subsystem\u001b[0m  \u2014  running many untrusted programs safely on one machine\r\n"]
[0.4, "o", "\r\n"]
[0.9, "o", "\u001b[36m# 1) A fork bomb is contained by the per-subtree process limit, not fatal\u001b[0m\r\n"]
[1.3, "o", "\u001b[32mpintos$\u001b[0m "]
