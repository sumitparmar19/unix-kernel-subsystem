[6.41, "o", "\u001b[33m(cpu-spin)\u001b[0m set CPU budget to 50 ticks\r\n"]
[6.52, "o", "\u001b[33m(cpu-spin)\u001b[0m spinning; the kernel should kill us at the budget\r\n"]
[6.63, "o", "\u001b[31mcpu-spin: exit(-1)\u001b[0m\r\n"]
[6.74, "o", "KSTAT syscalls=4 ctx_switches=814 page_faults=4 limit_denials=0 limit_kills=1\r\n"]
[7.34, "o", "\r\n"]
[7.84, "o", "\u001b[36m# 3) A well-behaved process still finishes ON TIME next to both abusers\u001b[0m\r\n"]
