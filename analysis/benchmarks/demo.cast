[13.56, "o", "\u001b[33m(page-parallel)\u001b[0m begin\r\n"]
[13.67, "o", "\u001b[33m(page-parallel)\u001b[0m exec \"child-linear\"  x4\r\n"]
[13.78, "o", "child-linear: exit(66)   (x4)\r\n"]
[13.89, "o", "\u001b[33m(page-parallel)\u001b[0m wait for child 0..3\r\n"]
[14.0, "o", "\u001b[33m(page-parallel)\u001b[0m end\r\n"]
[14.11, "o", "page-parallel: exit(0)\r\n"]
[14.22, "o", "\u001b[1mKSTAT evictions=164 swap_ins=3 swap_outs=159\u001b[0m   <- clock keeps the hot pages\r\n"]
[14.82, "o", "\r\n"]
[15.32, "o", "\u001b[36m# Full regression, every suite green:\u001b[0m\r\n"]
[15.52, "o", "\u001b[32m  threads 27/27   userprog 80/80   ipc 11/11   vm 113/113   limits 6/6\u001b[0m\r\n"]
[15.72, "o", "\r\n"]
[16.22, "o", "\u001b[36m# See the measured eviction-policy comparison above. Source on GitHub.\u001b[0m\r\n"]
