[2.294, "o", "\r\n"]
[2.404, "o", "\u001b[33m(fork-bomb)\u001b[0m begin\r\n"]
[2.514, "o", "\u001b[33m(fork-bomb)\u001b[0m set process limit to 8\r\n"]
[2.624, "o", "\u001b[33m(fork-bomb)\u001b[0m exec was capped at 7 children\r\n"]
[2.734, "o", "child-block: exit(0)\r\n"]
[2.844, "o", "child-block: exit(0)\r\n"]
[2.954, "o", "child-block: exit(0)\r\n"]
[3.064, "o", "child-block: exit(0)\r\n"]
[3.174, "o", "child-block: exit(0)\r\n"]
[3.284, "o", "child-block: exit(0)\r\n"]
[3.394, "o", "child-block: exit(0)\r\n"]
[3.504, "o", "\u001b[33m(fork-bomb)\u001b[0m all 7 contained children exited cleanly\r\n"]
[3.614, "o", "\u001b[33m(fork-bomb)\u001b[0m kernel still works after the bomb\r\n"]
[3.724, "o", "fork-bomb: exit(0)\r\n"]
[3.834, "o", "KSTAT syscalls=42 ctx_switches=1266 page_faults=12 limit_denials=1 limit_kills=0\r\n"]
[4.434, "o", "\r\n"]
[4.934, "o", "\u001b[36m# 2) A CPU hog is killed when it burns its scheduling budget\u001b[0m\r\n"]
