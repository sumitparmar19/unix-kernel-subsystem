# -*- makefile -*-
# Resource-limit suite.  Built with VM so the page limit (LIMIT_PAGES)
# can be exercised by a process that grows its memory at run time.

kernel.bin: DEFINES = -DUSERPROG -DFILESYS -DVM
KERNEL_SUBDIRS = threads devices lib lib/kernel userprog filesys vm
TEST_SUBDIRS = tests/limits
GRADING_FILE = $(SRCDIR)/tests/limits/Grading
SIMULATOR = --qemu
