# -*- makefile -*-
# Hardening suite: regression tests for the four kernel bugs
# fixed in docs/adr/ADR-003 and ADR-004.  Built with VM so the pinning and
# eviction paths (B2-B4) and the page limit (B1) are all exercised.

kernel.bin: DEFINES = -DUSERPROG -DFILESYS -DVM
KERNEL_SUBDIRS = threads devices lib lib/kernel userprog filesys vm
TEST_SUBDIRS = tests/hardening
GRADING_FILE = $(SRCDIR)/tests/hardening/Grading
SIMULATOR = --qemu
